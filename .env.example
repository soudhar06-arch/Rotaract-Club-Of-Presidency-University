# Copy this file to .env.local. Never commit .env.local or real credentials.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Rotaract Club Platform

# Google Calendar (calendar must be public for API-key access)
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_API_KEY=

# Google service account used by Drive and Sheets
GOOGLE_PROJECT_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep this quoted and preserve the literal \\n characters from the downloaded JSON key.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# Google Drive folder IDs (the value after /folders/ in each folder URL)
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_PROJECTS_FOLDER_ID=
GOOGLE_DRIVE_GALLERY_FOLDER_ID=
GOOGLE_DRIVE_BOD_FOLDER_ID=

# Google Sheets spreadsheet IDs and exact tab names
GOOGLE_SHEETS_MEMBERSHIP_ID=
GOOGLE_SHEETS_MEMBERSHIP_TAB=Form Responses 1
GOOGLE_SHEETS_PROJECTS_ID=
GOOGLE_SHEETS_PROJECTS_TAB=Projects
GOOGLE_SHEETS_BOD_ID=
GOOGLE_SHEETS_BOD_TAB=BOD
GOOGLE_SHEETS_EVENTS_ID=
GOOGLE_SHEETS_EVENTS_TAB=List of Events
PROJECTS_DATA_SOURCE=cms
BOD_DATA_SOURCE=cms

# Supabase CMS, authentication and optional media fallback
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=club-media

# Admin bootstrap login (use a long unique password)
ADMIN_DEV_USERNAME=
ADMIN_DEV_PASSWORD=
# Generate at least 32 random characters, for example: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# OpenAI: Leviathan Bot and event-description generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Contact, membership and collaboration email delivery
RESEND_API_KEY=
RESEND_FROM_EMAIL=Rotaract Website <website@your-verified-domain.example>
CLUB_APPLICATION_EMAIL=

# Public links
NEXT_PUBLIC_MEMBERSHIP_FORM_URL=

# Optional authoritative event metadata JSON file
EVENT_DETAILS_FILE_PATH=
